# Optional — improves web discovery quality (pick one)
# SerpAPI: https://serpapi.com/ (recommended for Google results)
SERPAPI_KEY=

# Google Custom Search: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Set to "false" to disable DuckDuckGo fallback web discovery
# DISCOVERY_ENABLED=false

# Set to "false" to skip homepage/about enrichment during scrape (catalog stats still collected)
# SCRAPER_ENRICH_SITE=false

# Protects the /api/scrape cron endpoint
CRON_SECRET=

# Signs user session cookies (required in production)
SESSION_SECRET=

# --- Production database ---
# Option A: Turso (libSQL) — works on Manus, Vercel, or anywhere serverless
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Option B: Omit Turso and use data/peptides.db (local dev, or Manus Reserved with persistent disk)
# Option C: Manus managed MySQL — wire up when merging into your Manus backend (not yet configured)

# --- Link to your main Manus site (traffic + branding) ---
NEXT_PUBLIC_PARENT_SITE_URL=https://your-main-site.com
NEXT_PUBLIC_PARENT_SITE_NAME=Your Site Name
# Full URL where this tool is hosted, e.g. https://search.your-main-site.com
NEXT_PUBLIC_APP_URL=
# If embedded under a path on your main domain, e.g. /peptide-search
# NEXT_PUBLIC_BASE_PATH=/peptide-search
